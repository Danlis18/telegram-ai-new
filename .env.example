# Preferred when migrating the dedicated Telegram Desktop account from tdata.zip:
TELEGRAM_SESSION_FILE_B64=

# Alternative: a separately-created Telethon StringSession:
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# Dedicated non-rotating SOCKS5 used ONLY by the Telegram reader.
# Leave all fields blank to disable proxy mode.
TELEGRAM_PROXY_HOST=
TELEGRAM_PROXY_PORT=
TELEGRAM_PROXY_USER=
TELEGRAM_PROXY_PASSWORD=
TELEGRAM_PROXY_RDNS=true

TELEGRAM_BOT_TOKEN=
TARGET_CHANNEL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AUTO_PUBLISH=false
MIN_PUBLISH_SCORE=70
DATABASE_PATH=data/news.db
SESSION_FILE_PATH=data/telegram_reader.session
