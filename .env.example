# ==================== TELEGRAM BOT ====================
TELEGRAM_BOT_TOKEN=
ADMIN_USER_ID=
TARGET_CHANNEL=
TELEGRAM_CONCURRENT_UPDATES=8

# ==================== TELEGRAM READER ====================
# Preferred production format: authorized .session file encoded as base64.
# Large values can be split; chunks are concatenated in numeric order.
TELEGRAM_SESSION_FILE_B64_1=
TELEGRAM_SESSION_FILE_B64_2=
SESSION_FILE_PATH=data/telegram_reader.session

# Optional alternative StringSession flow.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# Dedicated non-rotating SOCKS5 for Telethon/opentele2.
# Leave all fields blank to disable proxy mode.
TELEGRAM_PROXY_HOST=
TELEGRAM_PROXY_PORT=
TELEGRAM_PROXY_USER=
TELEGRAM_PROXY_PASSWORD=
TELEGRAM_PROXY_RDNS=true

# ==================== PREMIUM PUBLISHER ====================
# Authorized Premium Telegram user-account .session, also split when needed.
TELEGRAM_PUBLISHER_SESSION_FILE_B64_1=
TELEGRAM_PUBLISHER_SESSION_FILE_B64_2=

# ==================== OPENAI ====================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-2
MIN_PUBLISH_SCORE=70

# ==================== PUBLISHING ====================
AUTO_PUBLISH=false
PUBLISH_TIMEZONE=Europe/Kyiv

# ==================== MINI APP ====================
# Optional explicit override. Railway domain is detected automatically otherwise.
MINIAPP_PUBLIC_URL=

# ==================== WEB DISCOVERY ====================
WEB_NEWS_MAX_AGE_HOURS=12
WEB_NEWS_MIN_SCORE=62
WEB_NEWS_MAX_PER_DAY=8
WEB_NEWS_INTERVAL_SECONDS=900
WEB_NEWS_INITIAL_DELAY_SECONDS=75

# ==================== DAILY MATCHES ====================
DAILY_FIXTURES_TIME=09:00
DAILY_FIXTURES_INITIAL_DELAY_SECONDS=150

# ==================== STORAGE ====================
# On Railway, attach a Volume at /data. The runtime automatically switches the
# default SQLite path to /data/sports_news.db.
DATABASE_PATH=data/news.db
